# Supabase project configuration — copy to .env and fill in to activate
# real Supabase Auth (and, in later sprints, database + storage).
# Without these, the app runs against the built-in development auth driver.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
